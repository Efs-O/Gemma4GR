# Copy this file to .env and fill in your values
# NEVER commit .env to git

# HuggingFace token (get a new one at huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# Paths (defaults work if you haven't moved anything)
GGUF_CACHE_DIR=N:\.cache\huggingface\hub
GEMMA4KIDS_DIR=C:\Users\efso office\Desktop\Gemma4Kids
ADVANLLM_DIR=C:\Users\efso office\Desktop\ADVANCOPY230425

# Moira model
MOIRA_REPO=moiralabs/GreekTTS-1.5
ORPHEUS_BASE=unsloth/orpheus-3b-0.1-ft

# Training targets
E2B_MODEL=unsloth/gemma-4-E2B-it
E4B_MODEL=unsloth/gemma-4-E4B-it

# Pair generation
NUM_PAIRS=3000
AUDIO_SAMPLE_RATE_STT=16000
AUDIO_SAMPLE_RATE_PIPER=22050

# llama.cpp server
LLAMA_SERVER_PORT=8080
