# Copy this file to .env and fill in your values
# NEVER commit .env to git

# HuggingFace token (get a new one at huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# OpenRouter (optional — voice sentence list default provider; also used when QA_PROVIDER=openrouter)
# OPENROUTER_API_KEY=

# Kaggle (CSS10 Greek — training/download_css10_kaggle.py)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=paste_api_key_from_kaggle_json
# Optional slow-link tuning:
# KAGGLE_CONNECT_TIMEOUT=180
# KAGGLE_READ_TIMEOUT=none

# Paths (defaults work if you haven't moved anything)
GGUF_CACHE_DIR=N:\.cache\huggingface\hub
GEMMA4KIDS_DIR=C:\Users\efso office\Desktop\Gemma4Kids
ADVANLLM_DIR=C:\Users\efso office\Desktop\ADVANCOPY230425

# Moira model
MOIRA_REPO=moiralabs/GreekTTS-1.5
ORPHEUS_BASE=unsloth/orpheus-3b-0.1-ft
# Optional: local Orpheus snapshot path for training/generate_pairs.py (default: models/orpheus)
# ORPHEUS_MODEL_DIR=
# Set to 0 to generate with Orpheus base only (no Greek Moira LoRA)
USE_MOIRA_LORA=1
# Voice sweep: python training/generate_pairs_voice_sweep.py (8 Orpheus names × PAIRS_PER_VOICE)
# ORPHEUS_VOICE_NAMES=tara,leah,jess,leo,dan,mia,zac,zoe
PAIRS_PER_VOICE=2

# Training targets
E2B_MODEL=unsloth/gemma-4-E2B-it
E4B_MODEL=unsloth/gemma-4-E4B-it

# Human voice sentence list generation (default: OpenRouter; set OPENROUTER_API_KEY)
VOICE_SENTENCE_PROVIDER=openrouter
VOICE_SENTENCE_MODEL=google/gemini-2.5-flash
# VOICE_SENTENCE_PROVIDER=ollama
# VOICE_SENTENCE_MODEL=qwen3.5:397b-cloud
VOICE_SENTENCE_TARGET=3000
VOICE_SENTENCE_BATCH_SIZE=60
VOICE_SENTENCE_TEMPERATURE=0.7
VOICE_SENTENCE_KEEP_ALIVE=0s
# Optional: force Ollama to unload the model between batches
VOICE_SENTENCE_UNLOAD_MODEL=0

# Piper Docker fine-tune — checkpoint path (.ckpt), not .onnx
# PIPER_BASE_CKPT=

# Piper training dataset (LJSpeech: wavs/ + metadata.csv with id|text rows).
# Default if unset: data/piper_dataset (from prepare_piper_dataset.py).
# Human recorder output lives here — uncomment when training from recordings:
# PIPER_DATASET_DIR=data/human_voice_dataset

# Pair generation
NUM_PAIRS=3000
AUDIO_SAMPLE_RATE_STT=16000
AUDIO_SAMPLE_RATE_PIPER=22050

# llama.cpp server
LLAMA_SERVER_PORT=8080
